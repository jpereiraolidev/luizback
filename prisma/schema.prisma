// ============================================================
// schema.prisma — Luizback
// ------------------------------------------------------------
// Consolidado: 
//   - InviteLink (convite por link rápido, expira)
//   - Sleep (substitui Water como registro principal de sono)
//   - RecordType + CustomRecord (registros personalizados)
//   - status em todos os registros históricos (soft delete)
//   - AuditLog (observabilidade)
//
// REGRA: nada é apagado. Registros ganham status.
//   active   = em uso
//   legacy   = mantido por compatibilidade (ex: Water)
//   archived = "deletado" pelo usuário (soft delete)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS & COUPLE
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coupleId String?
  couple   Couple? @relation(fields: [coupleId], references: [id])

  notifsSent     Notification[] @relation("NotifFrom")
  notifsReceived Notification[] @relation("NotifTo")

  ownedCouples Couple[] @relation("CoupleOwner")

  auditLogs AuditLog[]

  createdInviteLinks InviteLink[] @relation("InviteLinkCreator")

  @@map("users")
}

model Couple {
  id        String   @id @default(cuid())
  color     String   @default("pink")
  theme     String   @default("dark")
  createdAt DateTime @default(now())

  ownerId String
  owner   User   @relation("CoupleOwner", fields: [ownerId], references: [id])

  members User[]

  dependents Dependent[]
  tasks      CoupleTask[]
  data       CoupleData[]

  inviteLinks InviteLink[]
  recordTypes RecordType[]

  @@map("couples")
}

model Dependent {
  id        String    @id @default(cuid())
  name      String
  birthDate DateTime? @db.Date
  avatar    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  coupleId String
  couple   Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  // registros históricos (com status)
  water    Water[]
  sleep    Sleep[]
  pee      Pee[]
  poop     Poop[]
  behavior Behavior[]

  // registros personalizados
  customRecords CustomRecord[]

  @@index([coupleId])
  @@map("dependents")
}

// ============================================================
// NOTIFICAÇÕES (convite por email — fluxo original)
// ============================================================

enum NotificationType {
  COUPLE_INVITE
}

enum NotificationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model Notification {
  id     String             @id @default(cuid())
  type   NotificationType
  status NotificationStatus @default(PENDING)

  fromId String
  from   User   @relation("NotifFrom", fields: [fromId], references: [id], onDelete: Cascade)

  toId String
  to   User @relation("NotifTo", fields: [toId], references: [id], onDelete: Cascade)

  payload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([toId, status])
  @@index([fromId])
  @@index([fromId, toId, type, status])
  @@map("notifications")
}

// ============================================================
// CONVITE POR LINK RÁPIDO (expira)
// ============================================================

model InviteLink {
  id     String @id @default(cuid())
  token  String @unique @db.VarChar(64)

  coupleId String
  couple   Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("InviteLinkCreator", fields: [createdById], references: [id], onDelete: Cascade)

  expiresAt    DateTime
  maxUses      Int       @default(1)
  useCount     Int       @default(0)
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  lastUsedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([token])
  @@index([coupleId, revokedAt])
  @@index([expiresAt])
  @@map("invite_links")
}

// ============================================================
// REGISTROS DO DEPENDENTE — Water (LEGACY, mantido)
// ============================================================
// Water não é mais o tipo principal (Sleep assumiu).
// Registros existentes permanecem com status="legacy".
// Novos registros via POST /water continuam aceitos por compat.
// ============================================================

model Water {
  id        String   @id @default(cuid())
  amount    Int
  reason    String?
  timestamp DateTime
  date      DateTime @db.Date

  status String @default("active") // active | legacy | archived

  dependentId String
  dependent   Dependent @relation(fields: [dependentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dependentId, date])
  @@index([dependentId, date, status])
  @@map("water")
}

// ============================================================
// SONO — registro principal
// ============================================================

model Sleep {
  id          String    @id @default(cuid())
  durationMin Int       // duração em minutos
  startAt     DateTime
  endAt       DateTime? // null enquanto "dormindo agora"
  quality     String?   // "bom" | "regular" | "ruim" (livre)
  note        String?
  timestamp   DateTime  // momento do registro (default: startAt)
  date        DateTime  @db.Date // dia de referência

  status String @default("active")

  dependentId String
  dependent   Dependent @relation(fields: [dependentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dependentId, date])
  @@index([dependentId, date, status])
  @@map("sleep")
}

// ============================================================
// PEE / POOP / BEHAVIOR — mantidos
// ============================================================

model Pee {
  id        String   @id @default(cuid())
  size      String
  type      String
  note      String?
  timestamp DateTime
  date      DateTime @db.Date

  status String @default("active")

  dependentId String
  dependent   Dependent @relation(fields: [dependentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dependentId, date])
  @@index([dependentId, date, status])
  @@map("pee")
}

model Poop {
  id          String   @id @default(cuid())
  evacuated   Boolean
  consistency String?
  pain        Int      @default(0)
  note        String?
  timestamp   DateTime
  date        DateTime @db.Date

  status String @default("active")

  dependentId String
  dependent   Dependent @relation(fields: [dependentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dependentId, date])
  @@index([dependentId, date, status])
  @@map("poop")
}

model Behavior {
  id        String   @id @default(cuid())
  observed  String
  rule      String?
  action    String?
  duration  Int?
  result    String?
  timestamp DateTime
  date      DateTime @db.Date

  status String @default("active")

  dependentId String
  dependent   Dependent @relation(fields: [dependentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dependentId, date])
  @@index([dependentId, date, status])
  @@map("behavior")
}

// ============================================================
// REGISTROS PERSONALIZADOS
// ============================================================
// O casal cria seus próprios tipos ("Temperatura", "Remédio"...).
// RecordType.fields define o schema dos dados (JSON validado).
// ============================================================

model RecordType {
  id       String @id @default(cuid())
  coupleId String
  couple   Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  slug    String  // ex: "temperatura", "remedio" (URL-safe)
  label   String  // ex: "Temperatura"
  icon    String? // emoji ou URL
  fields  Json    // [{ name, label, type, required, options? }]
  active  Boolean @default(true)

  customRecords CustomRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([coupleId, slug])
  @@index([coupleId, active])
  @@map("record_types")
}

model CustomRecord {
  id          String   @id @default(cuid())
  typeId      String
  type        RecordType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  dependentId String
  dependent   Dependent @relation(fields: [dependentId], references: [id], onDelete: Cascade)

  data        Json     // payload validado contra RecordType.fields
  timestamp   DateTime
  date        DateTime @db.Date

  status String @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dependentId, date])
  @@index([typeId, date])
  @@index([dependentId, date, status])
  @@map("custom_records")
}

// ============================================================
// DADOS DO CASAL
// ============================================================

model CoupleTask {
  id       String    @id @default(cuid())
  text     String
  owner    String?
  priority String    @default("media")
  due      String?
  note     String?
  done     Boolean   @default(false)
  doneAt   DateTime?

  coupleId String
  couple   Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coupleId, done])
  @@map("couple_task")
}

model CoupleData {
  id       String @id @default(cuid())
  key      String
  value    String
  coupleId String
  couple   Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([coupleId, key])
  @@map("couple_data")
}

// ============================================================
// AUDIT LOG — observabilidade
// ============================================================

model AuditLog {
  id         String   @id @default(cuid())
  instanceId String
  requestId  String?

  level String
  event String

  method String?
  path   String?
  status Int?

  durationMs Int?

  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  ip        String?
  userAgent String?

  payload Json?
  error   String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([level, createdAt])
  @@index([event, createdAt])
  @@index([requestId])
  @@index([userId, createdAt])
  @@index([path, createdAt])
  @@index([status, createdAt])
  @@index([instanceId, createdAt])
  @@map("audit_logs")
}